# AWS AgentCore Runtime ARNs
# Copy this file to .env.local and fill in the values
AGENT_ARN_SUPERVISOR=arn:aws:bedrock-agentcore:REGION:ACCOUNT_ID:runtime/RUNTIME_ID_SUPERVISOR
AGENT_ARN_HR=arn:aws:bedrock-agentcore:REGION:ACCOUNT_ID:runtime/RUNTIME_ID_HR
AGENT_ARN_OPERATIONS=arn:aws:bedrock-agentcore:REGION:ACCOUNT_ID:runtime/RUNTIME_ID_OPERATIONS
AGENT_REGION=us-east-2
